{
  "name": "markitui",
  "version": "2.5.1",
  "description": "Moderne Desktop-App zur Konvertierung von Dokumenten in Obsidian Markdown per MarkItUI",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.node.json",
    "dist:win": "npm run build && electron-builder --win --dir",
    "dist:installer": "npm run build && electron-builder --win nsis --publish never",
    "start": "electron ."
  },
  "keywords": [
    "markitui",
    "obsidian",
    "markdown",
    "school",
    "converter",
    "electron"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.16.0",
    "marked": "^15.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.markitui.app",
    "productName": "MarkItUI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "python_engine"
    ],
    "extraResources": [
      {
        "from": "python_engine",
        "to": "python_engine"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MarkItUI",
      "uninstallDisplayName": "MarkItUI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "runAfterFinish": true
    }
  }
}
